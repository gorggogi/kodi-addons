<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.qualitycheck" name="Quality Check" version="1.3.0" provider-name="gorggogi">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Warns when a video's real resolution or bitrate is low</summary>
        <description lang="en_GB">Shows a warning if a video is still below 1080p a few seconds after it starts playing, or if its bitrate is low for its resolution. Stays quiet otherwise. The resolution, warning levels and notification length can be changed in the settings.</description>
        <platform>all</platform>
    </extension>
</addon>
<addon id="repository.gorggogi" name="gorggogi Repository" version="1.0.0" provider-name="gorggogi">
    <extension point="xbmc.addon.repository" name="gorggogi Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/gorggogi/kodi-quality-check/main/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/gorggogi/kodi-quality-check/main/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/gorggogi/kodi-quality-check/main/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Add-ons by gorggogi</summary>
        <description lang="en_GB">Installs and updates add-ons by gorggogi, including Quality Check.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
